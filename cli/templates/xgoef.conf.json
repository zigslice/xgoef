{
  "productName": "__NAME__",
  "version": "0.0.1",
  "identifier": "com.example.__NAME__",
  "build": {
    "frontendDist": "web",
    "devUrl": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "__NAME__",
        "width": 960,
        "height": 640,
        "url": "xgoef://app/index.html"
      }
    ]
  },
  "cef": {
    "rootEnv": "CEF_ROOT",
    "noSandbox": true,
    "cacheDir": "root_cache"
  },
  "plugins": ["fs", "os"],
  "plugin": {
    "fs": {
      "allow": ["$APP", "$RESOURCE"]
    }
  },
  "capabilities": [
    {
      "identifier": "main",
      "windows": ["main"],
      "permissions": ["greet", "fs:read_text", "os:platform", "core:default"]
    }
  ]
}
