{
  "productName": "xgoef-hello",
  "version": "0.0.1",
  "identifier": "com.example.xgoef.hello",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "xgoef hello",
        "width": 960,
        "height": 640,
        "url": "xgoef://app/index.html"
      }
    ],
    "menu": [
      {
        "id": "file",
        "text": "File",
        "items": [
          {"id": "greet", "text": "Greet", "command": "greet"}
        ]
      }
    ],
    "tray": {
      "tooltip": "xgoef hello",
      "menu": [
        {"id": "greet", "text": "Greet", "command": "greet"}
      ]
    },
    "deepLink": {
      "schemes": ["xgoef-hello"]
    }
  },
  "cef": {
    "rootEnv": "CEF_ROOT",
    "noSandbox": true,
    "cacheDir": "root_cache"
  },
  "plugins": ["fs", "os", "clipboard"],
  "plugin": {
    "fs": {
      "allow": ["$APP", "$RESOURCE"]
    }
  },
  "capabilities": [
    {
      "identifier": "main",
      "windows": ["main"],
      "permissions": ["greet", "open_aux", "progress", "menu:popup", "tray:popup", "tray:click", "fs:read_text", "os:platform", "clipboard:read_text", "clipboard:write_text", "deeplink:get_current", "core:default"]
    },
    {
      "identifier": "aux",
      "windows": ["aux"],
      "permissions": ["greet", "core:default"]
    }
  ]
}
