{
  "productName": "xgoef-hello",
  "version": "0.0.1",
  "identifier": "com.example.xgoef.hello",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "xgoef hello",
        "width": 960,
        "height": 640,
        "url": "xgoef://app/index.html"
      }
    ],
    "menu": [
      {
        "id": "file",
        "text": "File",
        "items": [
          {"id": "greet", "text": "Greet", "command": "greet"}
        ]
      }
    ],
    "tray": {
      "tooltip": "xgoef hello",
      "menu": [
        {"id": "greet", "text": "Greet", "command": "greet"}
      ]
    },
    "deepLink": {
      "schemes": ["xgoef-hello"]
    }
  },
  "cef": {
    "rootEnv": "CEF_ROOT",
    "noSandbox": true,
    "cacheDir": "root_cache"
  },
  "plugins": ["fs", "os", "clipboard", "process", "notification", "global-shortcut", "monitor", "webview"],
  "commands": [
    {
      "name": "greet",
      "doc": "返回 hello 文本",
      "args": [{ "name": "name", "type": "string", "optional": true }],
      "result": "string"
    },
    { "name": "open_aux", "result": "string" },
    {
      "name": "progress",
      "args": [{ "name": "channel", "type": "XgoefChannel" }],
      "result": "string"
    },
    { "name": "wait", "result": "string" }
  ],
  "plugin": {
    "fs": {
      "allow": ["$APP", "$RESOURCE"]
    },
    "notification": {
      "allow": ["$APP"]
    },
    "global-shortcut": {
      "allow": ["Control+Shift+X"]
    },
    "webview": {
      "devtools": true
    }
  },
  "capabilities": [
    {
      "identifier": "main",
      "windows": ["main"],
      "permissions": ["greet", "open_aux", "progress", "wait", "menu:popup", "tray:popup", "tray:click", "fs:read_text", "os:platform", "clipboard:read_text", "clipboard:write_text", "deeplink:get_current", "process:exit", "process:relaunch", "notification:is_permission_granted", "notification:request_permission", "notification:show", "global-shortcut:register", "global-shortcut:unregister", "global-shortcut:unregister_all", "global-shortcut:is_registered", "monitor:list", "monitor:primary", "monitor:current", "monitor:scale", "monitor:move", "webview:print", "webview:open_dev_tools", "webview:close_dev_tools", "webview:is_dev_tools_open", "core:default"]
    },
    {
      "identifier": "aux",
      "windows": ["aux"],
      "permissions": ["greet", "core:default"]
    }
  ]
}
