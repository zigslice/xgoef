{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zigslice/xgoef/blob/main/xgoef.conf.schema.json",
  "title": "xgoef.conf.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "productName": { "type": "string" },
    "version": { "type": "string" },
    "identifier": { "type": "string" },
    "build": {
      "type": "object",
      "properties": {
        "frontendDist": { "type": "string", "default": "web" },
        "devUrl": { "type": "string" },
        "assetPublicKey": {
          "type": "string",
          "description": "Base64 Ed25519 public key. When set, the host serves the signed frontend from the binary trailer or xgoef.assets."
        }
      }
    },
    "app": {
      "type": "object",
      "properties": {
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string", "default": "main" },
              "title": { "type": "string" },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "url": { "type": "string" },
              "decorations": {
                "type": "boolean",
                "default": true,
                "description": "When false, a Views window hides its title bar and borders. Native (--use-native) windows ignore this."
              },
              "theme": {
                "type": "string",
                "enum": ["system", "light", "dark"],
                "default": "system",
                "description": "system follows the OS. light and dark set that window's Chrome color scheme. The first window also sets the process-wide native frame with --force-light-mode or --force-dark-mode."
              },
              "transparent": {
                "type": "boolean",
                "default": false,
                "description": "Requests a fully transparent browser background. Windowed CEF paints that as opaque white, so the desktop does not show through."
              }
            },
            "required": ["title", "width", "height"]
          }
        },
        "menu": {
          "type": "array",
          "description": "Window menu bar. Item clicks run command through capabilities.",
          "items": { "$ref": "#/$defs/menuItem" }
        },
        "tray": {
          "type": "object",
          "description": "Status icon and its menu. Left click emits tray; the menu runs commands.",
          "properties": {
            "tooltip": { "type": "string" },
            "icon": { "type": "string" },
            "menu": {
              "type": "array",
              "items": { "$ref": "#/$defs/menuItem" }
            }
          }
        },
        "windowState": {
          "type": "boolean",
          "default": true,
          "description": "Remember each window's position, size, and maximized flag in .xgoef/window-state.json."
        },
        "singleInstance": {
          "type": "boolean",
          "default": true,
          "description": "When identifier is set, a second launch focuses the first process. Set false to allow more than one."
        },
        "deepLink": {
          "type": "object",
          "additionalProperties": false,
          "description": "Custom URL schemes. The running app registers them for the current user and accepts matching arguments.",
          "properties": {
            "schemes": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "cef": {
      "type": "object",
      "properties": {
        "rootEnv": { "type": "string", "default": "CEF_ROOT" },
        "noSandbox": { "type": "boolean", "default": true },
        "cacheDir": { "type": "string" }
      }
    },
    "commands": {
      "type": "array",
      "description": "App invoke shapes. xgoef build and xgoef dev write web/xgoef.d.ts from these plus the enabled plugins.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "doc": { "type": "string" },
          "result": {
            "type": "string",
            "description": "TypeScript result. Empty means null. Allowed: string, number, boolean, null, unknown, XgoefChannel, T[], A | B, and { name: T; name?: T }."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "optional": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "plugins": {
      "type": "array",
      "description": "Builtin plugin ids to load (fs, os, shell, clipboard, dialog, updater, process, notification, global-shortcut, monitor).",
      "items": { "type": "string" }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allow": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Scope roots. $APP, $RESOURCE, $HOME, or a path."
            },
            "deny": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "shell": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schemes": { "type": "array", "items": { "type": "string" } },
            "allow": { "type": "array", "items": { "type": "string" } },
            "deny": { "type": "array", "items": { "type": "string" } }
          }
        },
        "dialog": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allow": { "type": "array", "items": { "type": "string" } },
            "deny": { "type": "array", "items": { "type": "string" } }
          }
        },
        "clipboard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["memory", "system"] }
          }
        },
        "notification": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional icon scope. An empty allow list still permits a title and body.",
          "properties": {
            "allow": { "type": "array", "items": { "type": "string" } },
            "deny": { "type": "array", "items": { "type": "string" } }
          }
        },
        "global-shortcut": {
          "type": "object",
          "additionalProperties": false,
          "description": "Accelerators the page may register. An empty allow list rejects every shortcut.",
          "properties": {
            "allow": { "type": "array", "items": { "type": "string" } }
          }
        },
        "updater": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": {
              "type": "string",
              "description": "Directory or https URL that serves update.json and xgoef.assets."
            }
          }
        }
      }
    },
    "capabilities": {
      "description": "Tauri-like capability list (P0 ACL). Legacy map form is also accepted by the loader.",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "identifier": { "type": "string" },
              "windows": {
                "type": "array",
                "items": { "type": "string" }
              },
              "permissions": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "required": ["identifier", "permissions"]
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "commands": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "menuItem": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "command": { "type": "string" },
        "enabled": { "type": "boolean", "default": true },
        "separator": { "type": "boolean" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/menuItem" }
        }
      }
    }
  },
  "required": ["productName", "app"]
}
